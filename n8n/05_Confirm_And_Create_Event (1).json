    {
      "parameters": {
        "jsCode": "const ctx = $('Validate Input').first().json;\nconst lock = $('Call 09 - Lock Slot').first().json.rows[0];\nconst req = $('Call 09 - Get Request').first().json.rows[0];\nlet parsed = {};\ntry { parsed = JSON.parse(req.parsed_json || '{}'); } catch (e) { parsed = {}; }\nconst toIso = (s) => String(s).replace(' ', 'T') + '+07:00';\nconst title = parsed.title || String(req.user_command || 'Su kien moi').slice(0, 100);\nconst eventId = 'aisec' + ctx.request_id + ctx.slot_code.toLowerCase(); // id co dinh => chong tao trung (409)\nconst body = {\n  id: eventId,\n  summary: title,\n  location: parsed.location || undefined,\n  description: 'Tạo bởi AI Secretary (request #' + ctx.request_id + ', phương án ' + ctx.slot_code + ')',\n  start: { dateTime: toIso(lock.start_time), timeZone: 'Asia/Ho_Chi_Minh' },\n  end: { dateTime: toIso(lock.end_time), timeZone: 'Asia/Ho_Chi_Minh' },\n  reminders: { useDefault: false, overrides: [{ method: 'popup', minutes: 30 }] } // Google Calendar native reminder\n};\nreturn [{ json: { gcal_body: body, event_id: eventId, title, location: parsed.location || null } }];"
      },

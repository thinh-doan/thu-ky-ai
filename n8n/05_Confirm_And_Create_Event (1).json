    {
      "parameters": {
        "jsCode": "const ctx = $('Validate Input').first().json;\nconst r = $input.first().json;\nconst s = r.success ? r.rows[0] : null;\nlet code, message;\nif (!r.success) { code = 'DB_ERROR'; message = 'Khong khoa duoc phuong an: ' + (r.error || ''); }\nelse if (!s) { code = 'SLOT_NOT_FOUND'; message = 'Khong tim thay phuong an ' + ctx.slot_code + ' cua request ' + ctx.request_id + '.'; }\nelse if (s.status === 'created' || s.status === 'confirming') { code = 'ALREADY_PROCESSED'; message = 'Phuong an nay da/dang duoc xu ly (trang thai: ' + s.status + ').'; }\nelse if (s.status === 'expired' || Number(s.is_expired) === 1) { code = 'PROPOSAL_EXPIRED'; message = 'Phuong an da het han; vui long tao yeu cau moi.'; }\nelse { code = 'SLOT_NOT_AVAILABLE'; message = 'Phuong an khong o trang thai co the xac nhan (' + s.status + ').'; }\nreturn [{ json: { response: { status: 'error', error_code: code, request_id: ctx.request_id, slot_code: ctx.slot_code, slot_status: s ? s.status : null, message } } }];"
      },

    {
      "parameters": {
        "jsCode": "const ctx = $('Validate Input').first().json;\nconst r = $input.first().json;\nconst err = (c, m) => [{ json: { ok: false, response: { status: 'error', error_code: c, request_id: ctx.request_id, slot_code: ctx.slot_code, message: m } } }];\nif (!r.success) return err('DB_ERROR', 'Khong doc duoc yeu cau: ' + (r.error || ''));\nconst req = r.rows[0];\nif (!req) return err('REQUEST_NOT_FOUND', 'Khong tim thay request_id ' + ctx.request_id);\nif (req.external_user_id !== ctx.user_id) return err('FORBIDDEN', 'request_id khong thuoc ve user nay');\nif (req.intent !== 'create_event') return err('INVALID_REQUEST_INTENT', 'Yeu cau nay khong phai la tao lich moi.');\nreturn [{ json: { ok: true, operation: 'lock_slot', data: { request_id: ctx.request_id, slot_code: ctx.slot_code, allow_retry: true } } }];"

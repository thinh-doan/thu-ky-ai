        "jsCode": "const ctx = $('Validate Input').first().json;\nconst prep = $('Prep GCal Create').first().json;\nconst res = $input.first().json;\nconst code = res.statusCode;\nif (code === 200 || code === 201) {\n  const b = res.body || {};\n  return [{ json: { gcal_ok: true, google_event_id: b.id || prep.event_id, html_link: b.htmlLink || null, already_existed: false } }];\n}\nif (code === 409) { // id da ton tai: lan truoc da tao xong => dung lai, khong tao trung\n  return [{ json: { gcal_ok: true, google_event_id: prep.event_id, html_link: null, already_existed: true } }];\n}\nconst detail = code ? 'HTTP ' + code : (typeof res.error === 'string' ? res.error : (res.error && res.error.message) || 'khong ro');\nreturn [{ json: { gcal_ok: false, slot_status: 'failed', response: { status: 'error', error_code: 'GCAL_CREATE_FAILED', request_id: ctx.request_id, slot_code: ctx.slot_code, message: 'Google Calendar tu choi tao lich (' + detail + '). Ban co the bam thu lai.' } } }];"

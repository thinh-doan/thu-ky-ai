    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Validate Input').first().json;\nconst res = $input.first().json;\nconst myId = 'aisec' + ctx.request_id + ctx.slot_code.toLowerCase();\nconst base = { request_id: ctx.request_id, slot_code: ctx.slot_code };\nif (res.error || !Array.isArray(res.items)) {\n  return [{ json: { blocked: true, slot_status: 'failed', response: { status: 'error', error_code: 'GCAL_CHECK_FAILED', ...base, message: 'Khong kiem tra duoc xung dot tren Google Calendar; vui long thu lai.' } } }];\n}\nconst conflicts = res.items\n  .filter((ev) => ev.status !== 'cancelled' && ev.transparency !== 'transparent' && ev.id !== myId && ev.id !== ctx.delete_event_id)\n  .map((ev) => ({ event_id: ev.id, title: ev.summary || '(khong tieu de)', start_time: (ev.start && (ev.start.dateTime || ev.start.date)) || null, end_time: (ev.end && (ev.end.dateTime || ev.end.date)) || null }));\nif (conflicts.length > 0) {\n  return [{ json: { blocked: true, slot_status: 'slot_taken', response: { status: 'slot_taken', ...base, conflicts, message: 'Khung gio nay da co lich khac. Gui confirm_action=replace_conflict kem delete_event_id de thay the, hoac chon phuong an khac.' } } }];\n}\nreturn [{ json: { blocked: false } }];"
      },

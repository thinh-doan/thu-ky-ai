    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst action = body.action;\nconst errors = [];\n\nif (!['submit_request', 'confirm_action', 'confirm_import', 'submit_image'].includes(action)) {\n  errors.push('action khong hop le');\n}\nif (!body.user_id) errors.push('thieu user_id');\n\nif (action === 'submit_request' && !String(body.message || '').trim()) {\n  errors.push('thieu message');\n}\nif (action === 'submit_image' && !String(body.image_base64 || '').trim()) {\n  errors.push('thieu image_base64');\n}\nif (action === 'confirm_import' && (!Array.isArray(body.selected_items) || body.selected_items.length === 0)) {\n  errors.push('thieu selected_items');\n}\n\nif (action === 'confirm_action') {\n  const m = body.confirm_action || body.sub_action;\n  if (!['create', 'replace_conflict', 'update', 'delete'].includes(m)) {\n    errors.push('confirm_action khong hop le');\n  }\n\n  // Kiểm tra: Bắt buộc có thông tin slot CSDL HOẶC danh sách events gửi trực tiếp\n  if (['create', 'replace_conflict'].includes(m)) {\n    const hasDbSlot = body.request_id && body.selected_slot_code;\n    const hasDirectEvents = (Array.isArray(body.events) && body.events.length > 0) || body.event_data;\n\n    if (!hasDbSlot && !hasDirectEvents) {\n      errors.push('Thieu thong tin tao lich: Can (request_id & selected_slot_code) hoac danh sach events');\n    }\n  }\n\n  if (m === 'replace_conflict' && !body.delete_event_id) errors.push('thieu delete_event_id');\n  if (['update', 'delete'].includes(m) && !body.target_event_id && !body.target_title) errors.push('thieu target_event_id');\n  if (m === 'update' && !body.updates) errors.push('thieu updates');\n}\n\nreturn [{\n  json: {\n    ...body,\n    confirm_action: body.confirm_action || body.sub_action,\n    is_valid: errors.length === 0,\n    validation_errors: errors\n  }\n}];"
      },

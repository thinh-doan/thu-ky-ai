      "parameters": {
        "jsCode": "const ai = $('Call 01 - AI Parse').first().json;\nlet code = 'AI_PARSE_ERROR';\nlet message = ai.error_message || 'Khong phan tich duoc yeu cau.';\nif (ai.status === 'needs_clarification') { code = 'NEEDS_CLARIFICATION'; message = ai.clarification_question || 'Vui long cung cap them thong tin.'; }\nelse if (ai.status === 'unsupported') { code = 'UNSUPPORTED_REQUEST'; message = 'Yeu cau nam ngoai pham vi ho tro.'; }\nelse if (ai.status === 'ok') { code = 'INTENT_NOT_IMPLEMENTED'; message = 'Intent ' + ai.intent + ' hay dung confirm_action update/delete (Workflow 06).'; }\nreturn [{ json: { response: { status: 'error', error_code: code, ai_status: ai.status, intent: ai.intent, message } } }];"
      },
